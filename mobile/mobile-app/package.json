{
  "name": "mobile-app",
  "main": "expo-router/entry",
  "version": "1.0.5",
  "scripts": {
    "start": "node --max-old-space-size=8192 node_modules/expo/bin/cli start --go -c",
    "dev": "node --max-old-space-size=8192 node_modules/expo/bin/cli start --go -c",
    "tunnel": "node --max-old-space-size=8192 node_modules/expo/bin/cli start --go --tunnel -c",
    "android": "node --max-old-space-size=8192 node_modules/expo/bin/cli start --go -c --android",
    "ios": "node --max-old-space-size=8192 node_modules/expo/bin/cli start --go -c --ios",
    "web": "node --max-old-space-size=8192 node_modules/expo/bin/cli start -c --web",
    "clean": "rm -rf .expo node_modules",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e:visitor": "jest -c e2e/jest.e2e.config.js --runInBand --forceExit",
    "test:e2e:amenity": "jest -c e2e/jest.amenity.config.js --runInBand --forceExit",
    "postinstall": "node scripts/patch-css-interop.js",
    "build:aab": "eas build --platform android --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:android:local": "eas build --platform android --profile production --local",
    "bundle:android": "cd android && gradlew bundleRelease"
  },
  "dependencies": {
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.4.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.39",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@reduxjs/toolkit": "^2.12.0",
    "@rn-primitives/portal": "~1.4.0",
    "@rn-primitives/slot": "^1.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.5.8",
    "axios": "^1.18.1",
    "buffer": "^6.0.3",
    "burnt": "^0.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dijkstrajs": "^1.0.1",
    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-auth-session": "~57.0.13",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.19",
    "expo-contacts": "~57.0.0",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.0",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.3",
    "libphonenumber-js": "^1.13.14",
    "lucide-react-native": "^1.21.0",
    "nativewind": "^4.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.82.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "semver": "^7.8.5",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@expo/ngrok": "^4.1.3",
    "@react-native-community/cli": "^20.2.0",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/react": "~19.2.4",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "qrcode-terminal": "^0.12.0",
    "react-test-renderer": "19.1.0",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3",
    "undici": "^7.30.0"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|lucide-react-native|@testing-library/.*|@rn-primitives/.*|immer|react-redux|@reduxjs/toolkit)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/e2e/"
    ]
  }
}
