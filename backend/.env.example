# Registry Settings
DOCKER_REGISTRY=atocash
IMAGE_TAG=prd1.0

# External Port Configurations
CLIENT_PORT=3005
SERVER_PORT=5007
DB_PORT_EXTERNAL=27019
REDIS_PORT_EXTERNAL=6379

# Database Credentials
MONGO_ROOT_USER=manageadmin
MONGO_ROOT_PASSWORD=ManageAdminPwd@123

# Database Connection URI (Note: @ in password is URL-encoded as %40)
# For Docker Containers (backend -> mongodb):
MONGODB_URI=mongodb://manageadmin:ManageAdminPwd%40123@mongodb:27017/manage_my_gate_prod?replicaSet=rs0&authSource=admin
# For MongoDB Compass via PuTTY SSH Tunnel (Port Forward 27019 -> localhost:27019):
# MONGODB_URI=mongodb://manageadmin:ManageAdminPwd%40123@localhost:27019/manage_my_gate_prod?directConnection=true&authSource=admin

# Redis Cache URI
REDIS_URL=redis://redis:6379

