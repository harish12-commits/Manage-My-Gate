# Registry Settings
DOCKER_REGISTRY=atocash
IMAGE_TAG=prd1.0

# External Port Configurations
CLIENT_PORT=3004
SERVER_PORT=5006
DB_PORT_EXTERNAL=27019
REDIS_PORT_EXTERNAL=6379

# Database Credentials
MONGO_ROOT_USER=manageadmin
MONGO_ROOT_PASSWORD=your_mongo_root_password_here

# Database Connection URI (Note: @ in password is URL-encoded as %40)
# For Docker Containers (backend -> mongodb):
MONGODB_URI=mongodb://manageadmin:your_mongo_root_password_here@mongodb:27017/manage_my_gate_prod?replicaSet=rs0&authSource=admin
# For MongoDB Compass via PuTTY SSH Tunnel (Port Forward 27019 -> localhost:27019):
# MONGODB_URI=mongodb://manageadmin:your_mongo_root_password_here@localhost:27019/manage_my_gate_prod?directConnection=true&authSource=admin

# Redis Cache URI
REDIS_URL=redis://redis:6379

# Encryption Keys
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

ALLOWED_ORIGINS=https://your-domain.com

SUPER_ADMIN_EMAIL=admin@enterprise.com
SUPER_ADMIN_PASSWORD=SuperAdminPwd@123

# Billing emails & pay-online links (docs/BILLING_EMAILS.md)
# Public web origin used in invoice email links; must proxy /api to this backend.
# Defaults to https://$MOBILE_UNIVERSAL_LINK_DOMAIN (app.managemygate.com).
# PUBLIC_APP_URL=https://app.managemygate.com
# Fallback Razorpay webhook secret when a community has none in Integration Hub.
# RAZORPAY_WEBHOOK_SECRET=

# Production requires a refresh secret distinct from JWT_SECRET, and JWT_SECRET >= 32 chars
JWT_REFRESH_SECRET=

# Production: separate 32+ char key used to encrypt payment/banking credentials (must differ from ENCRYPTION_KEY)
VAULT_ENCRYPTION_KEY=
# Local development only: allow the mock payment gateway (never set in production)
# ALLOW_MOCK_PAYMENTS=true
